{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BEC home page content",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "hero": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "description": "Background image key (autocompletes from R2).",
            "allOf": [
              {
                "$ref": "./_schema/asset-keys.json"
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "fit": {
            "description": "How the image fills the slide. \"cover\" (default) crops to fill; \"contain\" shows the whole image (letterboxed).",
            "type": "string",
            "enum": [
              "cover",
              "contain"
            ]
          }
        },
        "required": [
          "image",
          "title",
          "description"
        ],
        "additionalProperties": false
      },
      "description": "Full-screen carousel slides at the very top of the home page."
    },
    "about": {
      "type": "object",
      "properties": {
        "image": {
          "allOf": [
            {
              "$ref": "./_schema/asset-keys.json"
            }
          ]
        },
        "established": {
          "type": "string",
          "description": "Big number shown on the image, e.g. \"1963\"."
        },
        "establishedLabel": {
          "type": "string"
        },
        "slides": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Each entry is one carousel slide; each slide is a list of paragraphs."
        }
      },
      "required": [
        "image",
        "established",
        "establishedLabel",
        "slides"
      ],
      "additionalProperties": false,
      "description": "The 'About BEC' section: one image + the carousel of paragraphs."
    },
    "campusLife": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "allOf": [
              {
                "$ref": "./_schema/asset-keys.json"
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "className": {
            "description": "Optional Tailwind grid span controlling the card size, e.g. \"md:col-span-2 md:row-span-2\".",
            "type": "string"
          }
        },
        "required": [
          "image",
          "title",
          "description"
        ],
        "additionalProperties": false
      },
      "description": "The 'Student Life' feature cards near the bottom of the home page."
    }
  },
  "required": [
    "hero",
    "about",
    "campusLife"
  ],
  "additionalProperties": false
}
