{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BEC governance / leadership content",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "principal": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "photo": {
          "allOf": [
            {
              "$ref": "./_schema/asset-keys.json"
            }
          ]
        },
        "email": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "role",
        "photo"
      ],
      "additionalProperties": false,
      "description": "The Principal / Member Secretary shown in the leadership banner."
    },
    "deans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "photo": {
            "allOf": [
              {
                "$ref": "./_schema/asset-keys.json"
              }
            ]
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "focus": {
            "type": "string"
          },
          "link": {
            "type": "object",
            "properties": {
              "href": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "href",
              "label"
            ],
            "additionalProperties": false
          },
          "roleBadges": {
            "description": "Multiple role badges, each optionally linking to its own page.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "link": {
                  "type": "object",
                  "properties": {
                    "href": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "href",
                    "label"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "label"
              ],
              "additionalProperties": false
            }
          },
          "placeholder": {
            "type": "boolean"
          },
          "verify": {
            "type": "boolean"
          }
        },
        "required": [
          "role"
        ],
        "additionalProperties": false
      },
      "description": "Deans rendered in the #deans section."
    },
    "officers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "photo": {
            "allOf": [
              {
                "$ref": "./_schema/asset-keys.json"
              }
            ]
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "focus": {
            "type": "string"
          },
          "link": {
            "type": "object",
            "properties": {
              "href": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "href",
              "label"
            ],
            "additionalProperties": false
          },
          "roleBadges": {
            "description": "Multiple role badges, each optionally linking to its own page.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "link": {
                  "type": "object",
                  "properties": {
                    "href": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "href",
                    "label"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "label"
              ],
              "additionalProperties": false
            }
          },
          "placeholder": {
            "type": "boolean"
          },
          "verify": {
            "type": "boolean"
          }
        },
        "required": [
          "role"
        ],
        "additionalProperties": false
      },
      "description": "Other statutory officers (CoE, Librarian…)."
    },
    "hods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "department": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "photo": {
            "allOf": [
              {
                "$ref": "./_schema/asset-keys.json"
              }
            ]
          },
          "email": {
            "type": "string"
          },
          "placeholder": {
            "type": "boolean"
          }
        },
        "required": [
          "department"
        ],
        "additionalProperties": false
      },
      "description": "Heads of Department, in display order."
    },
    "sangha": {
      "type": "object",
      "properties": {
        "intro": {
          "type": "string"
        },
        "groupPhoto": {
          "allOf": [
            {
              "$ref": "./_schema/asset-keys.json"
            }
          ]
        },
        "chairman": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "photo": {
              "allOf": [
                {
                  "$ref": "./_schema/asset-keys.json"
                }
              ]
            },
            "messageHref": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "role",
            "photo"
          ],
          "additionalProperties": false
        },
        "secretary": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "photo": {
              "allOf": [
                {
                  "$ref": "./_schema/asset-keys.json"
                }
              ]
            }
          },
          "required": [
            "name",
            "role"
          ],
          "additionalProperties": false
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "photo": {
                "allOf": [
                  {
                    "$ref": "./_schema/asset-keys.json"
                  }
                ]
              }
            },
            "required": [
              "name",
              "role"
            ],
            "additionalProperties": false
          }
        },
        "council": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "invitee": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "role"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "groupPhoto",
        "chairman",
        "secretary",
        "members",
        "council"
      ],
      "additionalProperties": false,
      "description": "The B.V.V. Sangha parent-trust block."
    },
    "bog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "affiliation": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "chair",
              "sangha",
              "nominee",
              "industry",
              "academia",
              "faculty",
              "invitee",
              "government",
              "member-secretary",
              "students"
            ]
          },
          "photo": {
            "allOf": [
              {
                "$ref": "./_schema/asset-keys.json"
              }
            ]
          }
        },
        "required": [
          "name",
          "role",
          "affiliation",
          "category"
        ],
        "additionalProperties": false
      },
      "description": "Board of Governors members, grouped by category on the page."
    }
  },
  "required": [
    "principal",
    "deans",
    "officers",
    "hods",
    "sangha",
    "bog"
  ],
  "additionalProperties": false
}
